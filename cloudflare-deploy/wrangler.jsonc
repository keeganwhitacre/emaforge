{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ema-forge-study",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "STUDY_DATA",
      "bucket_name": "ema-forge-study-data"
    }
  ]
}
